# 이 파일을 .env로 복사한 뒤 값을 채운다.

# https://www.vworld.kr → 오픈API → 인증키 발급 (무료)
# 발급 시 "활용 URL"에 http://localhost:8000 을 등록해야 타일이 나온다.
VWORLD_KEY=

# Data API는 호출 도메인을 함께 검사한다. 인증키 신청 시 등록한 서비스 URL의
# 도메인과 맞춰야 하며, 서버에서 호출하므로 이 값이 없으면 인증이 거부된다.
# 개발 중에는 localhost, 배포 후에는 실제 도메인으로 바꾼다.
VWORLD_DOMAIN=localhost

# 1회 추출 면적 상한 (km²)
MAX_AREA_KM2=1.0

# 국토지리정보원 수치표고모델을 넣어 둘 폴더. 파일이 있으면 그 지역은 이걸 쓰고
# 없으면 전지구 자료로 넘어간다. 받는 방법은 dem/README.md 참고.
DEM_DIR=dem

# 좌표계 정보가 없는 DEM 배포본에 적용할 기본 좌표계
DEM_FALLBACK_CRS=EPSG:5186

# 산출물 보관 시간
OUTPUT_TTL_HOURS=24

# Overpass 공용 서버가 붐빌 때 대체 엔드포인트
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
