# 이 파일을 .env로 복사한 뒤 값을 채운다.

# https://www.vworld.kr → 오픈API → 인증키 발급 (무료)
# 발급 시 "활용 URL"에 서비스 주소를 등록해야 지도와 지적 데이터가 나온다.
VWORLD_KEY=

# Data API는 호출 도메인을 함께 검사한다. 서버에서 호출하므로 Referer가 없어
# 이 값을 명시해야 한다. 쉼표로 여러 개를 적으면 앞에서부터 시도한다.
VWORLD_DOMAIN=localhost

# 1회 추출 면적 상한 (km²)
MAX_AREA_KM2=1.0

# 동시에 처리할 작업 수. 워커가 하나라 무한정 받을 수 없다.
MAX_CONCURRENT_JOBS=3

# 산출물 보관 시간
OUTPUT_TTL_HOURS=24

# 사용 현황 대시보드(/admin) 접근 암호. 비워 두면 대시보드가 열리지 않는다.
# 아무 문자열이나 길게 넣으면 된다.
ADMIN_TOKEN=

# 배경지도를 브라우저가 V-World에서 직접 받게 할지
#   1  직결. 타일 장당 약 20 ms. 인증키가 프론트엔드에 노출된다
#   0  서버 중계. 키는 감춰지지만 약 57 ms
# 어느 쪽이든 지적 데이터 조회는 항상 서버가 대신 한다.
TILE_DIRECT=1

# 메일 발송 — 지메일은 반드시 앱 비밀번호를 쓴다(계정 비밀번호는 거부된다).
# https://myaccount.google.com/apppasswords 에서 발급 (2단계 인증 필요)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=지적도 DXF 추출

# 정품 안내에 표시할 입금 계좌
BANK_INFO=
# 데모 사용 기간(일). 처음 실행한 시점부터 센다.
DEMO_DAYS=3
SITE_URL=https://ks-down-map.com

# PC를 스스로 옮길 수 있는 간격(일). 윈도우 재설치·PC 교체 대비.
# 0이면 관리자만 풀어 줄 수 있다.
TRANSFER_COOLDOWN_DAYS=30
